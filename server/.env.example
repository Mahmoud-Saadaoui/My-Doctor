NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Neon PostgreSQL
# DATABASE_URL: pooled connection used by the application at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@EP-neon-project-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL: direct connection used by Prisma CLI migrations.
DIRECT_URL=postgresql://USER:PASSWORD@EP-neon-project.REGION.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m

# Map & Geocoding
# Maximum search radius in kilometers for doctor search
MAX_SEARCH_RADIUS_KM=50
# Default search radius in kilometers
DEFAULT_SEARCH_RADIUS_KM=10
# Appointment duration in minutes
APPOINTMENT_DURATION_MINUTES=30

# Email configuration (Nodemailer SMTP)
# In development, emails are logged to console if SMTP is not configured.
# In production, SMTP_HOST and SMTP_PORT are required.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@mydoctor.com
