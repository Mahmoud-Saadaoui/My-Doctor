generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  doctor
  normal
  admin
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
  no_show
}

model User {
  id                  Int            @id @default(autoincrement())
  name                String         @db.VarChar(120)
  email               String         @unique @db.VarChar(255)
  password            String         @db.VarChar(255)
  userType            UserType       @default(normal) @map("userType")
  isEmailVerified     Boolean        @default(false) @map("isEmailVerified")
  emailVerificationToken String?      @unique @map("emailVerificationToken")
  emailVerificationExpires DateTime?   @map("emailVerificationExpires")
  passwordResetToken  String?        @unique @map("passwordResetToken")
  passwordResetExpires DateTime?      @map("passwordResetExpires")
  createdAt           DateTime       @default(now()) @map("createdAt")
  updatedAt           DateTime       @updatedAt @map("updatedAt")
  profile             Profile?
  availabilities      Availability[]
  patientAppointments Appointment[]  @relation("PatientAppointments")
  doctorAppointments  Appointment[]  @relation("DoctorAppointments")

  @@index([userType])
  @@map("users")
}

model Profile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("userId")
  specialization  String   @db.VarChar(120)
  address         String   @db.VarChar(255)
  workingHours    String?  @map("workingHours") @db.VarChar(255)
  phone           String   @db.VarChar(40)
  bio             String?
  consultationFee Decimal? @map("consultationFee") @db.Decimal(10, 2)
  timezone        String   @default("Africa/Tunis") @db.VarChar(80)
  isVerified      Boolean  @default(false) @map("isVerified")
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now()) @map("createdAt")
  updatedAt       DateTime @updatedAt @map("updatedAt")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([specialization])
  @@index([latitude, longitude])
  @@map("profiles")
}

model Availability {
  id        Int      @id @default(autoincrement())
  doctorId  Int      @map("doctorId")
  dayOfWeek Int      @map("dayOfWeek")
  startTime DateTime @map("startTime") @db.Time(0)
  endTime   DateTime @map("endTime") @db.Time(0)
  timezone  String   @default("Africa/Tunis") @db.VarChar(80)
  isActive  Boolean  @default(true) @map("isActive")
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")
  doctor    User     @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([doctorId, dayOfWeek])
  @@map("availabilities")
}

model Appointment {
  id                 Int               @id @default(autoincrement())
  patientId          Int               @map("patientId")
  doctorId           Int               @map("doctorId")
  startsAt           DateTime          @map("startsAt") @db.Timestamptz(3)
  endsAt             DateTime          @map("endsAt") @db.Timestamptz(3)
  status             AppointmentStatus @default(pending)
  reason             String?
  notes              String?
  cancellationReason String?           @map("cancellationReason")
  createdAt          DateTime          @default(now()) @map("createdAt")
  updatedAt          DateTime          @updatedAt @map("updatedAt")
  patient            User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  doctor             User              @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@map("appointments")
}
